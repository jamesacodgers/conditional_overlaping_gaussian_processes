{
  "device": "cuda",
  "dataset": "oilflow",
  "models": [
    "gauss",
    "nn_gauss"
  ],
  "latent_dim": 10,
  "n_inducing": 64,
  "training_steps": {
    "gauss": 60000,
    "nn_gauss": 60000
  },
  "batch_size": 128,
  "learning_rate": 0.001,
  "random_seed": 2,
  "init_lengthscales": 0.001,
  "init_output_noise_scale": 1,
  "pca_init": false,
  "test_size": 0.1,
  "checkpoint_frequency": 4000,
  "metrics_frequency": 100,
  "enable_testing": true,
  "test_iterations": 5000,
  "enable_missing_data": false,
  "missing_data_ratio": 0.0,
  "reconstruction_samples": 50,
  "prior_type": {
    "gauss": "normal",
    "nn_gauss": "multivariate"
  },
  "kernel_type": "rbf",
  "use_ard": true,
  "mean_function": "zero",
  "variational_strategy": "cholesky",
  "learn_inducing_locations": true
}