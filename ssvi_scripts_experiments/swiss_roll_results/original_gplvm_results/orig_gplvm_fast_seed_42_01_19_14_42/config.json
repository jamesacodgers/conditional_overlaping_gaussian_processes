{
  "device": "cpu",
  "dataset": "oilflow",
  "models": [
    "gauss",
    "nn_gauss"
  ],
  "latent_dim": 2,
  "n_inducing": 10,
  "training_steps": {
    "gauss": 5000,
    "nn_gauss": 5000
  },
  "batch_size": 50,
  "learning_rate": 0.01,
  "random_seed": 42,
  "init_lengthscales": 2.0,
  "init_output_noise_scale": 2.0,
  "pca_init": true,
  "test_size": 0.2,
  "checkpoint_frequency": 1000,
  "metrics_frequency": 1000,
  "enable_testing": true,
  "test_iterations": 1000,
  "enable_missing_data": false,
  "missing_data_ratio": 0.3,
  "reconstruction_samples": 100,
  "prior_type": {
    "gauss": "normal",
    "nn_gauss": "multivariate"
  },
  "kernel_type": "rbf",
  "use_ard": true,
  "mean_function": "zero",
  "variational_strategy": "cholesky",
  "learn_inducing_locations": true
}